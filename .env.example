# CineStream — environment variables (names only; never commit real values)

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cinestream?schema=public"

# Auth (choose one strategy when auth is implemented)
NEXTAUTH_SECRET=""
# CLERK_SECRET_KEY=""

# TMDB API (https://www.themoviedb.org/settings/api)
# v3 API key (32-char hex, sent as api_key query param) or v4 read access token (sent as Bearer).
# Server-only name required; this key must NEVER be exposed to the browser.
TMDB_API_KEY=""

# Video CDN (Cloudflare Stream / Bunny.net) — server-only
VIDEO_CDN_BASE_URL=""